  <footer class="container">
    <p class="muted">© Tours Languedoc by Irène — авторская организация термальных программ в Occitanie.</p>
  </footer>

  <script>
    // включение админ-ссылок параметром ?admin=lamalou2025
    (function(){
      const p = new URLSearchParams(location.search).get('admin');
      if(p === 'lamalou2025'){
        document.querySelectorAll('.admin-only').forEach(el=>{ el.style.display = el.dataset.display || 'block'; });
      }
    })();

    // безопасный предпросмотр и отправка через contact.js (ни один мессенджер не открывается до заполнения)
    (function(){
      const form = document.querySelector('[data-contact-form]');
      if(!form) return;
      form.addEventListener('submit', function(e){
        e.preventDefault();
        const fd = new FormData(form);
        const when   = (fd.get('date')||'').trim();
        const nights = (fd.get('nights')||'').trim();
        const guests = (fd.get('guests')||'').trim();
        const lodging= (fd.get('lodging')||'').trim();
        const contact= (fd.get('contact')||'').trim();
        const channel= (fd.get('channel')||'telegram');
        if(!when || !nights){ alert('Укажите дату и длительность (мин. 14 ночей).'); return; }
        if(!contact){ alert('Укажите контакт: телефон или @username.'); return; }
        const text = `Lamalou-les-Bains — запрос
`+
          `Даты: с ${when}, ночей: ${nights}
`+
          `Гостей: ${guests}
`+
          `Жильё: ${lodging}
`+
          `Контакт: ${contact}
`+
          `Пожелания: …`;
        const edited = prompt('Проверьте/отредактируйте текст заявки перед отправкой:', text);
        if(edited === null) return;
        window.dispatchEvent(new CustomEvent('contact:send', { detail: { channel, text: edited } }));
      }, { passive:false });
    })();
  </script>
